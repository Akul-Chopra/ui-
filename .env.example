# Template for .env.local: your machine's own values (git-ignored, never committed).
#   Copy-Item .env.example .env.local      (PowerShell)
#   cp .env.example .env.local             (bash)
# Only set what differs from the shared defaults in .env; delete the other lines.
# No secrets: every VITE_ value is compiled into the browser bundle.

# --- Dev server (`npm run dev`) ----------------------------------------------------------------
# Where the dev server proxies /api and /hubs. Default (.env): https://localhost:55844, the API
# started from Visual Studio. Examples:
#   http://localhost:5280          the API started with `dotnet run --urls http://localhost:5280`
#   https://ngps-uat.nsde.in/VPS_DEV_API   a deployed API (no local API needed)
VITE_DEV_API_TARGET=https://localhost:55844

# Dev server port. Default 5173.
VITE_DEV_PORT=5173

# --- Build (`npm run build`) ---------------------------------------------------------------------
# Usually left alone: use `npm run build` (site root) or `npm run build:iis` (/VPS + /VPSAPI).
# Path the app is served under, with a leading and trailing slash, e.g. /VPS_DEV_UI/
# VITE_BASE_PATH=/
# API location for the build: empty = same origin, or a path such as /VPS_DEV_API
# VITE_API_BASE_URL=
