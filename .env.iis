# Build settings for the IIS layout: the SPA as IIS application /VPS and the API as /VPSAPI on the
# same site. Used by `npm run build:iis` (vite --mode iis); overrides .env and .env.local.
# Not secrets: both end up in the bundle. For other application names, set the two values as
# environment variables for that build (they win over this file), see README "IIS".
VITE_BASE_PATH=/VPS/
VITE_API_BASE_URL=/VPSAPI
