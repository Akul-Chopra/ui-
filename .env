# Shared defaults, tracked in git. NOT for secrets: every VITE_ value is compiled into the browser bundle.
#
# Vite loads, lowest priority first:
#   .env  →  .env.local (yours, git-ignored)  →  .env.[mode] (e.g. .env.iis)  →  environment variables
# To change a value on your machine only, copy .env.example to .env.local and set it there.

# --- Dev server (`npm run dev`) ----------------------------------------------------------------
# Where the dev server proxies /api and /hubs: the VPS API as started from Visual Studio
# (VPS repo, src/VPS.API/Properties/launchSettings.json). For `dotnet run --urls http://localhost:5280`
# set VITE_DEV_API_TARGET=http://localhost:5280 in .env.local.
VITE_DEV_API_TARGET=https://localhost:55844
VITE_DEV_PORT=5173

# --- Build (`npm run build`) ---------------------------------------------------------------------
# Path the app is served under. "/" = site root. `npm run build:iis` uses /VPS/ (.env.iis).
VITE_BASE_PATH=/
# API location. Empty = same origin: the dev server proxy, or nginx/IIS serving the app and the API
# under one host. `npm run build:iis` uses /VPSAPI (.env.iis).
VITE_API_BASE_URL=
